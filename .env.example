PROJECT_NAME="Smart Weed Management API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (Default uses SQLite for easy local dev, can be switched to PostgreSQL/MySQL)
DATABASE_URL="sqlite:///./smart_weed.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_weed_db"
# DATABASE_URL="mysql+pymysql://root:password@localhost:3306/smart_weed_db"

# Security
SECRET_KEY="supersecretkey_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Clustering Defaults
DEFAULT_K=3
DEFAULT_MAX_ITER=300
DEFAULT_TOLERANCE=0.000001
